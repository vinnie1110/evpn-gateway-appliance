! Infra VPC Router — EVPN route relay (NOT a VTEP)
! Managed by Ansible — do not edit manually
!
! KNOWN OPEN ITEM: no route-map/prefix-list/route-target policy; maximum-prefix below is only a defensive backstop (source-audit.md §1, "No BGP policy or limits").
frr defaults traditional
hostname {{ inventory_hostname }}
log syslog informational
no ipv6 forwarding
!
router bgp {{ bgp.infra_asn }}
 bgp router-id {{ private_ip }}
 bgp log-neighbor-changes
 bgp graceful-restart
 no bgp ebgp-requires-policy
 no bgp default ipv4-unicast
 !
{% for host in groups['cloud_workload'] %}
 neighbor {{ hostvars[host].private_ip }} remote-as {{ bgp.workload_asn }}
 neighbor {{ hostvars[host].private_ip }} description {{ host }}
 neighbor {{ hostvars[host].private_ip }} ebgp-multihop 4
{% endfor %}
 !
 neighbor {{ tunnel.onprem_ip }} remote-as {{ bgp.onprem_asn }}
 neighbor {{ tunnel.onprem_ip }} description onprem-appliance
 !
 address-family ipv4 unicast
  network {{ private_ip }}/32
{% for host in groups['cloud_workload'] %}
  neighbor {{ hostvars[host].private_ip }} activate
  neighbor {{ hostvars[host].private_ip }} soft-reconfiguration inbound
{% endfor %}
  neighbor {{ tunnel.onprem_ip }} activate
  neighbor {{ tunnel.onprem_ip }} soft-reconfiguration inbound
 exit-address-family
 !
 address-family l2vpn evpn
{% for host in groups['cloud_workload'] %}
  neighbor {{ hostvars[host].private_ip }} activate
  neighbor {{ hostvars[host].private_ip }} attribute-unchanged next-hop
  neighbor {{ hostvars[host].private_ip }} maximum-prefix {{ bgp.max_prefix | default(1000) }}
{% endfor %}
  neighbor {{ tunnel.onprem_ip }} activate
  neighbor {{ tunnel.onprem_ip }} attribute-unchanged next-hop
  neighbor {{ tunnel.onprem_ip }} maximum-prefix {{ bgp.max_prefix | default(1000) }}
 exit-address-family
exit
!
end
